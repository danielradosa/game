    "oxc": "^1.0.1",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^6.0.3",
    "vite": "^5.3.3"
